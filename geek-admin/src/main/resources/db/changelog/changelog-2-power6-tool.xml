    <changeSet author="tao-business" id="power6-014-seed-knowledge-content-power6">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM knowledge_content WHERE id = 920006</sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO knowledge_content (
                id, title, subtitle, content, content_type, author_id, tags, biz_status, publish_time,
                view_count, like_count, comment_count, share_count, collect_count,
                json_data, create_id, create_by, create_time, status, del_flag, remark
            )
            SELECT
                920006, '「10倍好」潜能测评', '六大能力测评工具',
                '三框番号计分：目标力/专注力/执行力/协作力/抗压力/学习力。',
                'TOOL', 1, '潜能,测评,POWER6', 'PUBLISHED', NOW(),
                0, 0, 0, 0, 0,
                '{"toolCode":"POWER6","identityCode":"IDENTITY_P6","entry_url":"/#/tools/power6?contentId=920006","productCode":"SKILL_199_P6"}',
                1, 'admin', NOW(), '0', 0, 'P6工具种子'
            WHERE NOT EXISTS (SELECT 1 FROM knowledge_content WHERE id = 920006);
        </sql>
    </changeSet>

</databaseChangeLog>
