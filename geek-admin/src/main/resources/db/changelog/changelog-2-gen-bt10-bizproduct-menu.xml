<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="tao-business" id="gen-menu-bt10-bizproduct">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM sys_menu WHERE menu_id = 12980</sqlCheck>
        </preConditions>
        <loadData tableName="sys_menu" file="../data/sys_menu_gen_bt10_bizproduct.csv" separator="," encoding="UTF-8" relativeToChangelogFile="true">
            <column name="menu_id" type="BIGINT"/>
            <column name="menu_name" type="VARCHAR(50)"/>
            <column name="parent_id" type="BIGINT"/>
            <column name="order_num" type="INT"/>
            <column name="path" type="VARCHAR(200)"/>
            <column name="component" type="VARCHAR(255)"/>
            <column name="query" type="VARCHAR(255)"/>
            <column name="route_name" type="VARCHAR(50)"/>
            <column name="is_frame" type="INT"/>
            <column name="is_cache" type="INT"/>
            <column name="menu_type" type="CHAR(1)"/>
            <column name="visible" type="CHAR(1)"/>
            <column name="status" type="CHAR(1)"/>
            <column name="perms" type="VARCHAR(100)"/>
            <column name="icon" type="VARCHAR(100)"/>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="create_time" type="TIMESTAMPTZ"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="update_time" type="TIMESTAMPTZ"/>
            <column name="remark" type="VARCHAR(500)"/>
        </loadData>
    </changeSet>
    <changeSet author="tao-business" id="gen-role-menu-bt10-bizproduct">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM sys_role_menu WHERE menu_id = 12980</sqlCheck>
        </preConditions>
        <loadData tableName="sys_role_menu" file="../data/sys_role_menu_gen_bt10_bizproduct.csv" separator="," encoding="UTF-8" relativeToChangelogFile="true">
            <column name="role_id" type="BIGINT"/>
            <column name="menu_id" type="BIGINT"/>
        </loadData>
    </changeSet>
</databaseChangeLog>
