import request from '@/utils/request'

// 查询${functionName}列表
export function list${BusinessName}(query) {
  return request({
    url: '/${moduleName}/${businessName}/list',
    method: 'get',
    params: query
  })
}

// 查询${functionName}详细
export function get${BusinessName}(${pkColumn.javaField}) {
  return request({
    url: '/${moduleName}/${businessName}/' + ${pkColumn.javaField},
    method: 'get'
  })
}

// 新增${functionName}
export function add${BusinessName}(data) {
  return request({
    url: '/${moduleName}/${businessName}',
    method: 'post',
    data: data
  })
}

// 修改${functionName}
export function update${BusinessName}(data) {
  return request({
    url: '/${moduleName}/${businessName}',
    method: 'put',
    data: data
  })
}

// 删除${functionName}（支持单个 id 或 id 数组）
export function del${BusinessName}(${pkColumn.javaField}s) {
  const _ids = Array.isArray(${pkColumn.javaField}s) ? ${pkColumn.javaField}s.join(',') : ${pkColumn.javaField}s
  return request({
    url: `/${moduleName}/${businessName}/${_ids}`,
    method: 'delete'
  })
}
